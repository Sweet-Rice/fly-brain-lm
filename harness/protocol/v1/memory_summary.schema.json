{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_summary.schema.json",
  "title": "Fly Brain Visualization Stream v1 memory_summary",
  "type": "object",
  "required": [
    "type",
    "seq",
    "run_id",
    "request_id",
    "epoch",
    "t",
    "scale",
    "block",
    "heads",
    "head_dim",
    "dtype",
    "prev_rev",
    "rev",
    "dopamine_gate",
    "dopamine_cap",
    "recovery_half_life",
    "recovery_factor",
    "s_norm_before",
    "s_norm_after",
    "s_delta_norm"
  ],
  "properties": {
    "type": {"type": "string", "const": "memory_summary"},
    "seq": {"type": "integer", "minimum": 0},
    "run_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 0},
    "t": {"type": "integer", "minimum": 0},
    "scale": {"type": "integer", "minimum": 1},
    "block": {"type": "integer", "minimum": 0},
    "heads": {"type": "integer", "minimum": 1},
    "head_dim": {"type": "integer", "minimum": 1},
    "dtype": {"type": "string", "minLength": 1},
    "prev_rev": {"type": "integer", "minimum": 0},
    "rev": {"type": "integer", "minimum": 1},
    "dopamine_gate": {"$ref": "#/$defs/quantizedVector"},
    "dopamine_cap": {"$ref": "#/$defs/quantizedVector"},
    "recovery_half_life": {"$ref": "#/$defs/quantizedVector"},
    "recovery_factor": {"$ref": "#/$defs/quantizedVector"},
    "s_norm_before": {"$ref": "#/$defs/quantizedVector"},
    "s_norm_after": {"$ref": "#/$defs/quantizedVector"},
    "s_delta_norm": {"$ref": "#/$defs/quantizedVector"}
  },
  "additionalProperties": {"$ref": "#/$defs/extensionValue"},
  "x-flybrain-semantic-rules": [
    "real value = integer / scale for quantized values",
    "rev = prev_rev + 1",
    "rev counts observed writes of this block since the request started and S at rev 0 is the zero initial state",
    "t equals the token_step t of the same request_id",
    "vector lengths equal heads"
  ],
  "$defs": {
    "quantized": {
      "anyOf": [
        {"type": "integer"},
        {"type": "string", "enum": ["nan", "inf", "-inf", "missing"]}
      ]
    },
    "quantizedVector": {
      "type": "array",
      "items": {"$ref": "#/$defs/quantized"},
      "minItems": 1
    },
    "extensionValue": {
      "anyOf": [
        {"type": "integer"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/extensionValue"}},
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/extensionValue"}}
      ]
    }
  }
}
